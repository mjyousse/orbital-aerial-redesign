---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import FactBand from '../../components/FactBand.astro';
import Placeholder from '../../components/Placeholder.astro';
import CoverageGraphic from '../../components/CoverageGraphic.astro';
import Process from '../../components/Process.astro';
import Proof from '../../components/Proof.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import Arrow from '../../components/Arrow.astro';
import { url, aerialPackages, groundPackages, reStandards, reProcess, reAddons, rePoints } from '../../lib/site';
import hero from '../../assets/re/hero-aerial.jpg';
import t1 from '../../assets/re/travis-1.jpg';
import t2 from '../../assets/re/travis-2.jpg';
import t3 from '../../assets/re/travis-3.jpg';
import t4 from '../../assets/re/travis-4.jpg';
import t5 from '../../assets/re/travis-5.jpg';
import t6 from '../../assets/re/travis-6.jpg';
const gallery = [t1, t2, t3, t4, t5, t6];
const alts = ['Night aerial of a high-rise amenity deck with pool, Austin', 'Rooftop pool and lounge from above at night', 'High-rise residences and pool deck at dusk', 'Top-down night view of a lit courtyard pool', 'Downtown Austin towers at night from the air', 'Austin skyline and river at night from the air'];
const spans = ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-4'];
const large = await Promise.all(gallery.map((g) => getImage({ src: g, width: 1800, format: 'webp' })));
const pkgSlug = (t: string) => t.split(' (')[0];
---
<Base title="Real estate drone photography Austin" division="realestate" description="48 MP aerial stills and 4K property motion for Austin listings, with ground photography in the same visit. Published prices from $150. FAA Part 107 certificated, $10M aviation liability coverage.">
  <PhotoHero
    image={hero}
    credit="Photo: Orbital Aerial Solutions."
    eyebrow="Aerial media for Austin properties"
    title="Show the property."
    accent="Reveal the full perspective."
    lede="Purposeful aerial photos and cinematic motion that establish scale, setting and arrival, paired with ground coverage when the story calls for it."
    primary={{ href: '#quote', label: 'Request a quote' }}
    secondary={{ href: '#packages', label: 'View packages' }}
    notes={['FAA-compliant operations', 'Within 15 miles of Austin', 'Delivery as soon as 24 hours']}
  />

  <section id="work" class="section theme-light scroll-mt-16">
    <div class="wrap">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12" data-reveal>
        <div><p class="eyebrow">Selected work</p><h2 class="mt-5 display-lg">Recent coverage, shot by Orbital.</h2></div>
        <p class="text-text-2 max-w-sm">Select any frame to view it full screen.</p>
      </div>
      <ul class="grid grid-cols-2 lg:grid-cols-12 lg:auto-rows-[220px] gap-3 md:gap-4">
        {gallery.map((g, i) => (
          <li class:list={[spans[i], i === 0 && 'col-span-2']} data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <a href={large[i].src} class:list={['group block relative overflow-hidden rounded-[18px] h-full gallery-link', i === 0 ? 'aspect-[4/3] lg:aspect-auto' : 'aspect-[4/3] lg:aspect-auto']} data-index={i} aria-label={`Open photo: ${alts[i]}`}>
              <Picture src={g} alt={alts[i]} widths={[400, 700, 1000, 1400]} sizes={i === 0 ? '(min-width: 1024px) 720px, 100vw' : '(min-width: 1024px) 480px, 50vw'} formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-[1.04]" />
            </a>
          </li>
        ))}
      </ul>
      <dialog id="lightbox" class="m-auto bg-transparent backdrop:bg-black/90 max-w-[94vw] max-h-[90vh] p-0">
        <img id="lightbox-img" alt="" class="max-w-[94vw] max-h-[80vh] object-contain rounded-xl" />
        <div class="mt-3 flex justify-center gap-2">
          <button type="button" class="btn btn-ghost" data-lb="prev">Previous</button>
          <button type="button" class="btn btn-white" data-lb="close">Close</button>
          <button type="button" class="btn btn-ghost" data-lb="next">Next</button>
        </div>
      </dialog>
      <script>
        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.gallery-link'));
        const dlg = document.getElementById('lightbox') as HTMLDialogElement;
        const img = document.getElementById('lightbox-img') as HTMLImageElement;
        let idx = 0;
        const open = (i: number) => { idx = (i + links.length) % links.length; img.src = links[idx].href; img.alt = links[idx].querySelector('img')?.alt || ''; if (!dlg.open) dlg.showModal(); };
        links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); open(i); }));
        dlg.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-lb]') as HTMLElement | null; if (b) { const k = b.dataset.lb; if (k === 'close') dlg.close(); else open(idx + (k === 'next' ? 1 : -1)); } else if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') open(idx + 1); if (e.key === 'ArrowLeft') open(idx - 1); });
      </script>
      <div class="mt-6 ph p-6" role="note"><p class="ph-tag">Placeholder · Property film</p><p class="mt-3 text-[15px]">Add a 15–45 s aerial property clip (Vimeo/YouTube embed or MP4) here when one is ready.</p></div>
    </div>
  </section>

  <section id="standards" class="section theme-dark">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-10 items-end mb-16" data-reveal>
        <div><p class="eyebrow">The Orbital standard</p><h2 class="mt-5 display-lg text-white">Purpose-built media for high-performing listings.</h2></div>
        <p class="lede text-fg-2">Every flight and ground session is engineered for visual impact, MLS compliance and rapid turnaround.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/10 rounded-[20px] overflow-hidden">
        {reStandards.map((s, i) => (<div class="bg-ink-900 p-7 md:p-8 min-h-[260px] flex flex-col" data-reveal style={`--d:${i * 80}ms`}><span class="font-display text-4xl font-semibold text-signal tracking-tight">{s.id}</span><h3 class="mt-auto pt-10 text-2xl text-white">{s.title}</h3><p class="mt-3 text-fg-2 text-[15px]">{s.body}</p></div>))}
      </div>
    </div>
  </section>

  <section id="packages" class="section theme-warm scroll-mt-16">
    <div class="wrap">
      <SectionHead eyebrow="Packages · prices upfront" title="Straightforward aerial packages, priced upfront." lede="Start with aerial photos, aerial video, or both. Add a ground package when the listing needs interiors and exteriors too." size="lg" />
      {[aerialPackages, groundPackages].map((group, gi) => (
        <>
          {gi === 1 && <div class="mt-24"><SectionHead eyebrow="Ground photography" title="Interior and exterior coverage, same upfront pricing." lede="Choose the coverage that fits the property. We confirm access, scope and final price before the session." /></div>}
          <div class="grid md:grid-cols-3 gap-4">
            {group.map((p, i) => (
              <article class:list={['rounded-[22px] p-8 flex flex-col relative', p.featured ? 'bg-ink-900 text-white pkg-featured' : 'bg-paper']} data-reveal style={`--d:${i * 80}ms`}>
                <span class:list={['self-start chip', p.featured ? 'bg-signal text-black' : 'bg-paper-2 text-text-2']}>{p.badge}</span>
                <h3 class="mt-5 text-2xl">{p.title}</h3>
                <p class:list={['mt-1 text-[15px]', p.featured ? 'text-fg-2' : 'text-text-2']}>{p.subtitle}</p>
                <p class="mt-8 font-display text-6xl font-semibold tracking-[-0.05em] num">${p.price}</p>
                <ul class:list={['mt-8 pt-6 border-t space-y-3 text-[15px] flex-1', p.featured ? 'border-white/10' : 'line']}>
                  {p.features.map((f) => <li class="flex gap-3"><svg class:list={['mt-1 shrink-0', p.featured ? 'text-signal' : 'text-signal-700']} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{f}</li>)}
                </ul>
                <a href={url(`contact/?division=realestate&package=${encodeURIComponent(pkgSlug(p.title))}`)} class:list={['btn mt-10', p.featured ? 'btn-primary' : 'btn-dark']}>Request this package<Arrow /></a>
              </article>
            ))}
          </div>
        </>
      ))}
      <div class="mt-6 grid md:grid-cols-[1fr_auto] gap-4 items-center rounded-[22px] bg-paper p-7" data-reveal>
        <div>
          <p class="font-display text-xl font-semibold tracking-tight">Your approved quote is your final price.</p>
          <p class="mt-1 text-text-2 text-[15px]">Standard coverage is within 15 miles of Austin. Travel beyond that is quoted before you approve the scope. No surprise add-on fees.</p>
        </div>
        <a href="#quote" class="link-arrow text-[15px]">Builders: ask about volume rates<Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section theme-light">
    <div class="wrap">
      <SectionHead eyebrow="Available on request" title="Additional listing media when the property needs it." lede="Ask when you plan the shoot. Scope and price are confirmed before booking." />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line rounded-[20px] overflow-hidden">
        {reAddons.map((a, i) => <div class="bg-paper p-7" data-reveal style={`--d:${i * 80}ms`}><h3 class="text-xl">{a.title}</h3><p class="mt-2 text-text-2 text-[15px]">{a.body}</p></div>)}
      </div>
    </div>
  </section>

  <FactBand items={[
    { big: '48 MP', label: 'High-resolution aerial stills' },
    { big: '4K', label: 'Cinematic property motion' },
    { big: '$150', label: 'Published packages start here' },
    { big: '24 h', label: 'Delivery, as soon as the next day' },
  ]} />

  <Process eyebrow="How we shoot" title="Arrival, context, detail, delivery." steps={reProcess} />

  <section id="coverage" class="section theme-dark scroll-mt-16">
    <div class="wrap grid lg:grid-cols-[0.85fr_1.15fr] gap-12 items-center">
      <div data-reveal>
        <p class="eyebrow">Coverage area</p>
        <h2 class="mt-5 display-md text-white">15 miles around Austin, no travel fee.</h2>
        <p class="mt-6 lede text-fg-2">Farther out? We quote travel before you approve, so the price you see is still the price you pay.</p>
        <div class="mt-10 grid gap-6">
          {rePoints.map((p) => <div class="border-l-2 border-signal pl-5"><h3 class="text-lg text-white">{p.title}</h3><p class="text-fg-2 text-[15px] mt-1">{p.body}</p></div>)}
        </div>
      </div>
      <div data-reveal style="--d:120ms"><CoverageGraphic division="realestate" /></div>
    </div>
  </section>

  <section class="section-tight theme-light" aria-labelledby="re-clients-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Real estate clients</p>
      <h2 id="re-clients-title" class="mt-5 display-md max-w-[20ch]" data-reveal>Agents, brokerages and builders.</h2>
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-4" data-reveal>
        {[1, 2, 3, 4].map(() => <Placeholder label="Client logo" class="!bg-paper"><p class="text-sm">Brokerage or builder logo, added with permission.</p></Placeholder>)}
      </div>
    </div>
  </section>

  <Proof division="realestate" />
  <QuoteSection division="realestate" title="Let’s plan your property shoot." lede="Pick a package, share the address and a date. Standard coverage is within 15 miles of Austin." />
</Base>
