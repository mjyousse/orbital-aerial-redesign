---
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TerrainHero from '../../components/TerrainHero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import SectionHead from '../../components/SectionHead.astro';
import PointCloud from '../../components/PointCloud.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Process from '../../components/Process.astro';
import Proof from '../../components/Proof.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import { url, industrialServices, industrialPoints, industrialCredentials, industrialProcess, sectors } from '../../lib/site';
import stockpile from '../../assets/ind/industrial-stockpile.jpg';
import progress from '../../assets/ind/industrial-progress.jpg';
import infrastructure from '../../assets/ind/industrial-infrastructure.jpg';
const imgs: Record<string, ImageMetadata> = { stockpile, progress, infrastructure };
---
<Base title="Industrial drone mapping" division="industrial" description="Stockpile measurement, site progress models and asset documentation with RTK-enabled drones. FAA Part 107 certificated, fully insured, based in Austin, TX.">
  <TerrainHero
    eyebrow="Industrial · RTK-enabled mapping"
    title="Accurate aerial data for"
    accent="stockpiles, sites and assets."
    lede="We fly RTK-enabled drones, check against ground control when it’s in place, and deliver volumes, orthomosaics and 3D models in the formats your team already uses."
    primary={{ href: '#quote', label: 'Request a quote' }}
    secondary={{ href: '#services', label: 'View services' }}
    notes={['Photogrammetry in-house', 'State plane & local benchmarks', 'Web access for your team']}
  />
  <TrustStrip items={[
    { k: 'Positioning', v: 'RTK-enabled' },
    { k: 'Validation', v: 'Ground control checks' },
    { k: 'Pilots', v: 'FAA Part 107' },
    { k: 'Coverage', v: 'Fully insured' },
  ]} />

  <section id="services" class="section border-b hairline scroll-mt-20">
    <div class="wrap">
      <SectionHead eyebrow="Services" title="Three workflows, built around your decisions." lede="Measure material, document project progress, and capture hard-to-reach assets for technical review." />
      <div class="grid lg:grid-cols-3 gap-5">
        {industrialServices.map((s) => (
          <article class="panel overflow-hidden flex flex-col" data-reveal>
            <div class="relative aspect-[16/10]">
              <Picture src={imgs[s.image]} alt={s.imageAlt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 400px, 100vw" formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-900/90 to-transparent"></div>
              <span class="absolute left-4 top-4 tele bg-ink-950/85 px-2 py-1 rounded">{s.number} · {s.tag}</span>
              <a href={s.imageSource} class="absolute right-3 bottom-3 text-[11px] text-fg-2 underline bg-ink-950/80 px-2 py-0.5 rounded" target="_blank" rel="noreferrer">Licensed photo · Pexels</a>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-2xl text-white font-bold">{s.title}</h3>
              <p class="mt-3 text-fg-2 text-[15px]">{s.body}</p>
              <p class="mt-6 tele-muted">Typical deliverables</p>
              <ul class="mt-3 space-y-2 text-[15px]">
                {s.deliverables.map((d) => <li class="flex gap-2.5"><span class="mt-2.5 w-1.5 h-1.5 bg-cyan rounded-full shrink-0"></span><span>{d}</span></li>)}
              </ul>
              <p class="mt-auto pt-6 font-mono text-xs text-cyan">{s.formats}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-6 text-sm text-fg-3">Photos are licensed stock that show the type of site, not Orbital client work. Thermal inspection is in development and not offered yet.</p>
    </div>
  </section>

  <section id="sample-data" class="section border-b hairline scroll-mt-20">
    <div class="wrap">
      <SectionHead eyebrow="Sample data · Interactive" title="What the handoff looks like." lede="A mapping flight produces imagery, a surface model and a point cloud. Explore a public USGS sample of west Austin below. It isn’t client work." />
      <div class="grid lg:grid-cols-[1.35fr_1fr] gap-5 items-start">
        <div data-reveal><PointCloud /></div>
        <div data-reveal><BeforeAfter /></div>
      </div>
    </div>
  </section>

  <section id="advantage" class="section border-b hairline">
    <div class="wrap grid lg:grid-cols-[0.9fr_1.1fr] gap-12">
      <div data-reveal>
        <p class="tele">Why Orbital</p>
        <h2 class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">Field capture in, usable answers out.</h2>
        <p class="mt-5 text-lg text-fg-2">We turn raw flights into georeferenced, organized data your team can open in a browser or drop into CAD and GIS: Autodesk, Trimble and Bentley formats included. Final formats are confirmed while we scope.</p>
        <div class="mt-8">
          <p class="tele-muted">Sectors</p>
          <ul class="mt-3 flex flex-wrap gap-2">{sectors.map((s) => <li class="px-3 py-1.5 rounded-full border hairline text-sm text-fg-2">{s}</li>)}</ul>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {industrialPoints.map((p, i) => (
          <div class="panel p-6" data-reveal>
            <span class="tele-muted">0{i + 1}</span>
            <h3 class="mt-3 text-lg text-white font-semibold">{p.title}</h3>
            <p class="mt-2 text-fg-2 text-[15px]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Process eyebrow="Process" title="Five steps, no surprises." steps={industrialProcess} />

  <section id="credentials" class="section border-b hairline scroll-mt-20">
    <div class="wrap">
      <SectionHead eyebrow="Credentials" title="Safe, insured and documented." lede="Every job starts with flight safety planning, aviation liability coverage and a capture plan matched to how you’ll use the data." />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {industrialCredentials.map((c) => (
          <div class="panel p-6" data-reveal>
            <p class="tele">{c.label}</p>
            <h3 class="mt-3 text-xl text-white font-semibold">{c.title}</h3>
            <p class="mt-2 text-fg-2 text-[15px]">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Proof division="industrial" />
  <QuoteSection division="industrial" title="Let’s talk about your site." />
</Base>
