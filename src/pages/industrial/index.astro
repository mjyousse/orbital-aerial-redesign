---
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import DeliverableRow from '../../components/DeliverableRow.astro';
import StockpileMock from '../../components/mock/StockpileMock.astro';
import ProgressMock from '../../components/mock/ProgressMock.astro';
import AssetMock from '../../components/mock/AssetMock.astro';
import PointCloud from '../../components/PointCloud.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import FactBand from '../../components/FactBand.astro';
import Process from '../../components/Process.astro';
import FieldRecord from '../../components/FieldRecord.astro';
import LogoBand from '../../components/LogoBand.astro';
import SecuritySection from '../../components/SecuritySection.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import { industrialServices, industrialPoints, industrialCredentials, industrialProcess, sectors } from '../../lib/site';
import hero from '../../assets/stock/progress-2560.jpg';
const mocks = [StockpileMock, ProgressMock, AssetMock];
const icons = [
  'M4 6h16v12H4zM4 10h16M9 6v12',
  'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5',
  'M3 17l6-6 4 4 8-8M15 7h6v6',
  'M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6zM9 12l2 2 4-4',
];
---
<Base title="Industrial drone mapping" division="industrial" description="Survey-grade stockpile volumetrics, site progress digital twins and asset documentation. RTK-enabled, NDAA-compliant platforms with air-gapped data handling. Based in Austin, TX.">
  <PhotoHero
    image={hero}
    credit="Stock photo (Pexels) showing the type of site we fly. Not Orbital client work."
    eyebrow="Industrial reality capture · RTK-enabled workflows"
    title="Survey-grade data."
    accent="Stockpiles, sites, assets."
    lede="We merge structured flight operations with AI-driven processing pipelines to capture complex physical assets as high-accuracy geospatial datasets your engineers can act on and defend."
    primary={{ href: '#quote', label: 'Request a quote' }}
    secondary={{ href: '#services', label: 'View services' }}
    notes={['In-house photogrammetry', 'State plane & local benchmarks', 'Air-gapped data handling']}
  />

  <LogoBand />

  <section id="services" class="section theme-light scroll-mt-16">
    <div class="wrap">
      <SectionHead eyebrow="Services" title="Three workflows. One defensible dataset." lede="Measure material, document project progress and capture difficult-to-access assets with outputs built for engineering, inventory and site-management decisions." size="lg" />
      <div class="grid gap-28 md:gap-36">
        {industrialServices.map((s, i) => {
          const Mock = mocks[i];
          return <DeliverableRow id={s.id} flip={i % 2 === 1} tag={`${s.number} · ${s.tag}`} title={s.title} body={s.body} deliverables={s.deliverables} formats={s.formats} href="#quote" cta="Scope this service"><Mock /></DeliverableRow>;
        })}
      </div>
      <p class="mt-20 text-sm text-text-3">Photos are licensed stock that show the type of site, not Orbital client work. Product screens are sample layouts. Radiometric thermal capture is in capability development and not yet offered.</p>
    </div>
  </section>

  <section id="sample-data" class="section theme-dark scroll-mt-16">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-10 items-end mb-14" data-reveal>
        <div><p class="eyebrow">Sample data · Interactive</p><h2 class="mt-5 display-lg text-white">Inspect the deliverable.</h2></div>
        <p class="lede text-fg-2">A single mapping flight yields orthoimagery, a surface model and a dense point cloud. Explore a public USGS sample of west Austin below. It isn’t client work.</p>
      </div>
      <div class="grid lg:grid-cols-[1.45fr_1fr] gap-5 items-start">
        <div data-reveal><PointCloud /></div>
        <div data-reveal style="--d:120ms"><BeforeAfter /></div>
      </div>
    </div>
  </section>

  <section id="advantage" class="section theme-light">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-10 items-end mb-16" data-reveal>
        <div><p class="eyebrow">The Orbital advantage</p><h2 class="mt-5 display-lg">Built for precision. Engineered for scale.</h2></div>
        <p class="lede text-text-2">Orbital bridges the gap between field capture and operational insight. Outputs arrive georeferenced, metadata-tagged and ready for Autodesk, Trimble and Bentley. Final formats are confirmed during scoping.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line rounded-[20px] overflow-hidden">
        {industrialPoints.map((p, i) => (
          <div class="bg-paper p-7 md:p-8" data-reveal style={`--d:${i * 80}ms`}>
            <span class="grid place-items-center w-12 h-12 rounded-xl bg-ink-900 text-signal"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={icons[i]} /></svg></span>
            <h3 class="mt-8 text-xl">{p.title}</h3>
            <p class="mt-3 text-text-2 text-[15px]">{p.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 flex flex-wrap items-center gap-3" data-reveal>
        <p class="text-[14px] font-semibold mr-3">Sectors</p>
        {sectors.map((s) => <span class="px-4 py-2 rounded-full bg-paper-2 text-[14px] font-medium text-text-2">{s}</span>)}
      </div>
    </div>
  </section>

  <SecuritySection />

  <FactBand items={[
    { big: '$10M', label: 'Specialized aviation liability coverage' },
    { big: 'RTK', label: 'Enabled aircraft for repeatable mapping missions' },
    { big: 'NDAA', label: 'Compliant platforms, air-gapped ingestion' },
    { big: '1 day', label: 'Pricing and availability after scoping' },
  ]} />

  <Process eyebrow="Process" title="Scope to defensible deliverable in five steps." steps={industrialProcess} />

  <section id="credentials" class="section theme-dark scroll-mt-16">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-10 items-end mb-16" data-reveal>
        <div><p class="eyebrow">Credentials</p><h2 class="mt-5 display-lg text-white">Structured. Insured. Documented.</h2></div>
        <p class="lede text-fg-2">Every engagement begins with structured aviation safety planning, $10M in specialized aviation liability coverage and a capture plan matched to the intended operational use.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 rounded-[20px] overflow-hidden">
        {industrialCredentials.map((c, i) => (
          <div class="bg-ink-900 p-7 md:p-9" data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <p class="text-[13px] font-semibold text-signal">{c.label}</p>
            <h3 class="mt-4 text-2xl text-white">{c.title}</h3>
            <p class="mt-3 text-fg-2 text-[15px]">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FieldRecord eyebrow="Field record · Industrial" />
  <QuoteSection division="industrial" title="Let’s talk about your site." />
</Base>
