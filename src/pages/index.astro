---
import Base from '../layouts/Base.astro';
import TerrainHero from '../components/TerrainHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import DivisionCards from '../components/DivisionCards.astro';
import SectionHead from '../components/SectionHead.astro';
import PointCloud from '../components/PointCloud.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Process from '../components/Process.astro';
import Proof from '../components/Proof.astro';
import Founder from '../components/Founder.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { url, industrialProcess } from '../lib/site';

const services = [
  { d: 'industrial', t: 'Stockpile measurement', b: 'Volume and tonnage by pile, with PDF and CSV reporting and historical comparisons.', h: 'industrial/#services' },
  { d: 'industrial', t: 'Site progress & digital twins', b: 'Timestamped orthomosaics and interactive 3D models at every milestone.', h: 'industrial/#services' },
  { d: 'industrial', t: 'Asset documentation', b: 'Coordinate-tagged imagery of roofs, structures and utilities for engineering review.', h: 'industrial/#services' },
  { d: 'industrial', t: 'Contour & feasibility mapping', b: 'Engineering contours and surface models for site feasibility and early planning.', h: 'industrial/#services' },
  { d: 'realestate', t: 'Aerial photo & video', b: '48 MP stills and 4K cinematic motion for listings, from $230.', h: 'real-estate/#packages' },
  { d: 'realestate', t: 'Ground photography', b: 'Interiors and exteriors in the same visit, from $150.', h: 'real-estate/#packages' },
];
---
<Base title="Orbital Aerial Solutions" description="Aerial intelligence from Austin, TX: survey-grade mapping, stockpile volumetrics, reality capture and real estate aerial media. NDAA-compliant platforms, air-gapped data handling, $10M aviation liability coverage.">
  <TerrainHero
    eyebrow="Aerial intelligence · Austin, TX · Deployed nationwide"
    title="Aerial intelligence for operations where"
    accent="precision matters."
    lede="Subcentimeter geospatial mapping, survey-grade volumetrics and reality capture for industrial teams, plus cinematic aerial media for Austin real estate. Captured on NDAA-compliant platforms and processed into data your engineers can act on and defend."
    primary={{ href: url('contact/'), label: 'Request a quote' }}
    secondary={{ href: '#sample-data', label: 'Explore sample data' }}
  />
  <TrustStrip items={[
    { k: 'Flight crew', v: 'FAA Part 107 · Licensed pilot' },
    { k: 'Fleet', v: 'NDAA-compliant platforms' },
    { k: 'Data handling', v: 'Air-gapped ingestion' },
    { k: 'Liability coverage', v: '$10M aviation-specific' },
  ]} />

  <section class="section border-b hairline" aria-labelledby="divisions">
    <div class="wrap">
      <SectionHead eyebrow="Operational divisions" title="Two divisions. One aviation-grade standard." lede="Structured aerial capture for industrial measurement and documentation, alongside drone-led media for real estate and land marketing. Same crew, same safety framework, same discipline." />
      <h2 id="divisions" class="sr-only">Divisions</h2>
      <DivisionCards />
    </div>
  </section>

  <section id="sample-data" class="section border-b hairline scroll-mt-20" aria-labelledby="sample-title">
    <div class="wrap">
      <div class="max-w-3xl mb-12" data-reveal>
        <p class="tele">Sample data · Interactive</p>
        <h2 id="sample-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">Raw capture in. Measurable terrain out.</h2>
        <p class="mt-5 text-lg text-fg-2">Every mapping flight becomes a georeferenced 3D dataset. Orbit the point cloud, then drag the slider to compare the orthoimagery with its surface model. This demo uses free public USGS data for west Austin, not client work.</p>
      </div>
      <div class="grid lg:grid-cols-[1.35fr_1fr] gap-5 items-start">
        <div data-reveal><PointCloud /></div>
        <div data-reveal><BeforeAfter /></div>
      </div>
    </div>
  </section>

  <section class="section border-b hairline" aria-labelledby="services-title">
    <div class="wrap">
      <div class="max-w-3xl mb-12" data-reveal>
        <p class="tele">Capabilities</p>
        <h2 id="services-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">From raw capture to decision-ready data.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((s, i) => (
          <a href={url(s.h)} data-division={s.d} class="panel panel-hover p-6 group" data-reveal>
            <div class="flex justify-between items-center"><span class="tele">{s.d === 'industrial' ? 'Industrial' : 'Real estate'}</span><span class="tele-muted">0{i + 1}</span></div>
            <h3 class="mt-6 text-xl text-white font-semibold">{s.t}</h3>
            <p class="mt-2 text-fg-2 text-[15px]">{s.b}</p>
            <span class="mt-5 inline-block text-sm font-semibold text-[var(--accent)]">Learn more →</span>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm text-fg-3" data-reveal>Radiometric thermal capture is in capability development and not yet offered.</p>
    </div>
  </section>

  <Process eyebrow="How it works" title="Scope to defensible deliverable in five steps." steps={industrialProcess} />

  <section id="coverage" class="section border-b hairline" aria-labelledby="coverage-title">
    <div class="wrap grid lg:grid-cols-[0.8fr_1.2fr] gap-10 items-center">
      <div data-reveal>
        <p class="tele">Coverage</p>
        <h2 id="coverage-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">Austin-based. Deployed nationwide.</h2>
        <p class="mt-5 text-lg text-fg-2">Industrial projects are scoped and mobilized wherever the site is. Real estate shoots within 15 miles of downtown Austin carry no travel fee, and travel beyond that is quoted before you approve.</p>
      </div>
      <div data-reveal data-division="realestate"><CoverageMap division="realestate" /></div>
    </div>
  </section>

  <Founder />
  <Proof />
  <QuoteSection />
</Base>
