---
import Base from '../layouts/Base.astro';
import TerrainHero from '../components/TerrainHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import DivisionCards from '../components/DivisionCards.astro';
import SectionHead from '../components/SectionHead.astro';
import PointCloud from '../components/PointCloud.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Process from '../components/Process.astro';
import Proof from '../components/Proof.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { url, industrialProcess } from '../lib/site';

const services = [
  { d: 'industrial', t: 'Stockpile measurement', b: 'Volumes and tonnage by pile, with PDF and CSV reports.', h: 'industrial/#services' },
  { d: 'industrial', t: 'Site progress & digital twins', b: 'Dated orthomosaics and 3D models at each milestone.', h: 'industrial/#services' },
  { d: 'industrial', t: 'Asset documentation', b: 'Location-tagged imagery of roofs, structures and utilities.', h: 'industrial/#services' },
  { d: 'industrial', t: 'Contour & feasibility mapping', b: 'Surface models and contours for early site planning.', h: 'industrial/#services' },
  { d: 'realestate', t: 'Aerial photo & video', b: 'Listing-ready stills and 4K motion, from $230.', h: 'real-estate/#packages' },
  { d: 'realestate', t: 'Ground photography', b: 'Interiors and exteriors in the same visit, from $150.', h: 'real-estate/#packages' },
];
---
<Base title="Orbital Aerial Solutions" description="Drone mapping, stockpile volumes, site progress models and real estate aerial media in Austin, TX. FAA Part 107 certificated, fully insured, prices upfront.">
  <TerrainHero
    eyebrow="Austin, TX · FAA Part 107 · Fully insured"
    title="Drone data and aerial media,"
    accent="captured precisely."
    lede="We fly industrial sites and properties, then deliver what you actually need: volumes, maps, 3D models, or listing-ready photos and video. Scoped and priced before we take off."
    primary={{ href: url('contact/'), label: 'Request a quote' }}
    secondary={{ href: '#sample-data', label: 'Explore sample data' }}
  />
  <TrustStrip items={[
    { k: 'Pilots', v: 'FAA Part 107 certificated' },
    { k: 'Coverage', v: 'Aviation liability insured' },
    { k: 'Positioning', v: 'RTK-enabled aircraft' },
    { k: 'Turnaround', v: 'Reply within 1 business day' },
  ]} />

  <section class="section border-b hairline" aria-labelledby="divisions">
    <div class="wrap">
      <SectionHead eyebrow="Two divisions" title="Pick what you’re here for." lede="One crew, two kinds of work. Industrial clients get measurement-grade data; real estate clients get photos and video that sell the property." />
      <h2 id="divisions" class="sr-only">Divisions</h2>
      <DivisionCards />
    </div>
  </section>

  <section id="sample-data" class="section border-b hairline scroll-mt-20" aria-labelledby="sample-title">
    <div class="wrap">
      <div class="max-w-3xl mb-12" data-reveal>
        <p class="tele">Sample data · Interactive</p>
        <h2 id="sample-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">See what a mapping flight turns into.</h2>
        <p class="mt-5 text-lg text-fg-2">Aerial capture becomes a measurable 3D model. Orbit the point cloud, then drag the slider to compare the imagery with its surface model. This demo uses free public USGS data for west Austin, not client work.</p>
      </div>
      <div class="grid lg:grid-cols-[1.35fr_1fr] gap-5 items-start">
        <div data-reveal><PointCloud /></div>
        <div data-reveal><BeforeAfter /></div>
      </div>
    </div>
  </section>

  <section class="section border-b hairline" aria-labelledby="services-title">
    <div class="wrap">
      <div class="max-w-3xl mb-12" data-reveal>
        <p class="tele">Services</p>
        <h2 id="services-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">What we deliver.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {services.map((s, i) => (
          <a href={url(s.h)} data-division={s.d} class="panel panel-hover p-6 group" data-reveal>
            <div class="flex justify-between items-center"><span class="tele">{s.d === 'industrial' ? 'Industrial' : 'Real estate'}</span><span class="tele-muted">0{i + 1}</span></div>
            <h3 class="mt-6 text-xl text-white font-semibold">{s.t}</h3>
            <p class="mt-2 text-fg-2 text-[15px]">{s.b}</p>
            <span class="mt-5 inline-block text-sm font-semibold text-[var(--accent)]">Learn more →</span>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm text-fg-3" data-reveal>Thermal inspection is in development and isn’t offered yet.</p>
    </div>
  </section>

  <Process eyebrow="How it works" title="From first message to final files." steps={industrialProcess} />

  <section id="coverage" class="section border-b hairline" aria-labelledby="coverage-title">
    <div class="wrap grid lg:grid-cols-[0.8fr_1.2fr] gap-10 items-center">
      <div data-reveal>
        <p class="tele">Coverage</p>
        <h2 id="coverage-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">Based in Austin. Flying beyond it.</h2>
        <p class="mt-5 text-lg text-fg-2">Real estate shoots within 15 miles of downtown Austin carry no travel fee. Farther out, travel is quoted before you approve. Industrial projects are scoped wherever the site is.</p>
      </div>
      <div data-reveal data-division="realestate"><CoverageMap division="realestate" /></div>
    </div>
  </section>

  <Proof />
  <QuoteSection />
</Base>
