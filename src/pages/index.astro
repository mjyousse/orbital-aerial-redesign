---
import Base from '../layouts/Base.astro';
import VideoHero from '../components/VideoHero.astro';
import ServiceFork from '../components/ServiceFork.astro';
import FactBand from '../components/FactBand.astro';
import LogoBand from '../components/LogoBand.astro';
import CoverageGraphic from '../components/CoverageGraphic.astro';
import FieldRecord from '../components/FieldRecord.astro';
import Operate from '../components/Operate.astro';
import SecuritySection from '../components/SecuritySection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { url } from '../lib/site';
---
<Base title="Orbital Aerial Solutions" description="Orbital Aerial Solutions is an Austin, TX aerial intelligence firm: industrial mapping, volumetrics and reality capture nationwide, plus Real Estate Media for Austin listings. Fleet matched to contract requirements, $10M aviation liability coverage.">
  <VideoHero
    eyebrow="Aerial intelligence · Austin, TX · Deployed nationwide"
    title="Aerial intelligence for operations where precision matters."
    lede="Survey-grade mapping and reality capture for industrial teams, and cinematic aerial media for real estate. Two services, flown to one aviation standard."
    primary={{ href: url('contact/'), label: 'Request a quote' }}
    secondary={{ href: '#services', label: 'Choose a service' }}
    facts={[
      { k: 'Flight crew', v: 'Part 107 · Manned-aviation pilots' },
      { k: 'Fleet', v: 'Matched to the contract' },
      { k: 'Data handling', v: 'Air-gapped ingestion' },
      { k: 'Liability coverage', v: '$10M aviation-specific' },
    ]}
  />

  <ServiceFork />

  <section class="section theme-light" aria-label="About Orbital">
    <div class="wrap">
      <p class="font-display text-[clamp(1.7rem,3.6vw,3.2rem)] leading-[1.12] tracking-[-0.03em] font-medium max-w-[30ch]" data-reveal>
        Orbital merges structured flight operations with careful processing pipelines, <span class="text-text-3">turning aerial capture into data and media our clients can act on, publish and defend.</span>
      </p>
    </div>
  </section>

  <LogoBand />

  <FactBand items={[
    { big: '$10M', label: 'Specialized aviation liability coverage' },
    { big: 'Part 107', label: 'FAA-certified flight crew, with licensed manned-aviation pilots on the team' },
    { big: 'NDAA', label: 'Compliant aircraft available for contracts that require them' },
    { big: '1 day', label: 'Scoped pricing and availability, within one business day' },
  ]} />

  <Operate />

  <SecuritySection />

  <section id="coverage" class="section theme-dark scroll-mt-16" aria-labelledby="coverage-title">
    <div class="wrap grid lg:grid-cols-[0.8fr_1.2fr] gap-12 items-center">
      <div data-reveal>
        <p class="eyebrow">Coverage</p>
        <h2 id="coverage-title" class="mt-5 display-md text-white">Austin-based. Deployed nationwide.</h2>
        <p class="mt-6 lede text-fg-2">Flight crews mobilize from Austin to wherever the site is. Travel and mobilization are scoped per project and quoted before you approve.</p>
      </div>
      <div data-reveal style="--d:120ms"><CoverageGraphic division="industrial" /></div>
    </div>
  </section>

  <FieldRecord eyebrow="Field record · Industrial" />
  <QuoteSection both title="Tell us about your project." />
</Base>
