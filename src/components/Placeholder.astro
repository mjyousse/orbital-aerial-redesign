---
const { label = 'Placeholder', class: cls = '' } = Astro.props as { label?: string; class?: string };
---
<div class:list={['ph p-5', cls]} role="note" aria-label={`Placeholder: ${label}`}>
  <p class="ph-tag">Editor placeholder · {label}</p>
  <div class="mt-2 text-[15px]"><slot /></div>
</div>
