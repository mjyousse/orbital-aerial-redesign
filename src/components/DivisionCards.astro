---
import { Image, Picture } from 'astro:assets';
import { url } from '../lib/site';
import re from '../assets/re/travis-2.jpg';
import ind from '../assets/ind/industrial-stockpile.jpg';
const cards = [
  { key: 'industrial', href: url('industrial/'), color: 'cyan', tele: 'Division 01 · Industrial', title: 'Industrial & Land Intelligence', body: 'Stockpile volumetrics, engineering contour mapping, site feasibility models and builder progress reports. RTK-enabled, survey-grade and engineered for precision.', cta: 'Explore industrial', img: ind, alt: 'Aerial view of a quarry with stockpiles and machinery (licensed Pexels photo)', meta: 'PDF · CSV · GeoTIFF · LAS' },
  { key: 'realestate', href: url('real-estate/'), color: 'amber', tele: 'Division 02 · Real Estate', title: 'Real Estate Media', body: 'Drone-led property photography and 4K video for builder and agent listings, with ground packages in the same visit. Prices published upfront.', cta: 'See packages', img: re, alt: 'Night aerial of an Austin high-rise pool deck shot by Orbital', meta: 'From $150 · Delivery as soon as 24 h' },
];
---
<div class="grid md:grid-cols-2 gap-5">
  {cards.map((c) => (
    <a href={c.href} data-division={c.key} class="group panel panel-hover overflow-hidden flex flex-col" data-reveal>
      <div class="relative aspect-[16/9] overflow-hidden">
        <Picture src={c.img} alt={c.alt} widths={[480, 720, 960]} sizes="(min-width: 768px) 600px, 100vw" formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/20 to-transparent"></div>
        <span class="absolute left-4 top-4 tele bg-ink-950/85 px-2.5 py-1 rounded">{c.tele}</span>
      </div>
      <div class="p-6 sm:p-8 flex flex-col flex-1">
        <h3 class="text-3xl text-white font-bold">{c.title}</h3>
        <p class="mt-3 text-fg-2">{c.body}</p>
        <p class="mt-4 tele-muted">{c.meta}</p>
        <span class="mt-auto pt-6 inline-flex items-center gap-2 font-semibold text-[var(--accent)]">{c.cta}
          <svg class="transition-transform group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </div>
    </a>
  ))}
</div>
