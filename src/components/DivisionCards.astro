---
import { Picture } from 'astro:assets';
import { url } from '../lib/site';
import Arrow from './Arrow.astro';
import re from '../assets/re/travis-1.jpg';
import ind from '../assets/stock/stockpile-2560.jpg';
const cards = [
  { href: url('industrial/'), kicker: 'Industrial & land intelligence', title: 'Measure, document and model your sites.', body: 'Stockpile volumetrics, contour mapping, progress digital twins and asset documentation. RTK-enabled and survey-grade.', img: ind, alt: 'Top-down view of a quarry with sand and aggregate piles (stock photo)', credit: 'Stock photo', cta: 'Explore industrial' },
  { href: url('real-estate/'), kicker: 'Real estate media', title: 'Show the property. Reveal the full perspective.', body: '48 MP aerial stills, 4K cinematic motion and ground photography in one visit. Prices published upfront, from $150.', img: re, alt: 'Night aerial of a high-rise amenity deck with pool in Austin, shot by Orbital', credit: 'Shot by Orbital', cta: 'See packages' },
];
---
<div class="grid lg:grid-cols-2 gap-5">
  {cards.map((c, i) => (
    <a href={c.href} class="group relative block overflow-hidden rounded-[24px] min-h-[520px] md:min-h-[620px] text-white bg-ink-900" data-reveal style={`--d:${i * 120}ms`}>
      <Picture src={c.img} alt={c.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 640px, 100vw" formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(5_5_6/.1)_0%,rgb(5_5_6/.25)_40%,rgb(5_5_6/.92)_100%)]"></div>
      <span class="absolute right-5 top-5 chip chip-sample">{c.credit}</span>
      <div class="absolute inset-x-0 bottom-0 p-7 md:p-10">
        <p class="text-[14px] font-semibold text-white/80">{c.kicker}</p>
        <h3 class="mt-3 font-display text-[clamp(1.9rem,3.2vw,2.9rem)] leading-[1.02] tracking-[-0.035em] font-semibold max-w-[16ch]">{c.title}</h3>
        <p class="mt-4 text-white/80 max-w-md">{c.body}</p>
        <span class="mt-7 btn btn-white !min-h-11 !py-2.5">{c.cta}<Arrow /></span>
      </div>
    </a>
  ))}
</div>
