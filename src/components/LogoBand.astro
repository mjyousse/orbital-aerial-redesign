---
import { url } from '../lib/site';
// Official marks, stored unaltered in public/logos/ (single-color black). Heights are tuned per mark for even optical size.
const { label = 'Industrial clients include' } = Astro.props as { label?: string };
const logos = [
  { file: 'spacex.svg', name: 'SpaceX', h: 19, ratio: 8.212 },
  { file: 'samsung.svg', name: 'Samsung', h: 21, ratio: 6.529 },
  { file: 'martin-marietta.svg', name: 'Martin Marietta', h: 34, ratio: 3.431 },
  { file: 'tesla.svg', name: 'Tesla', h: 17, ratio: 7.671 },
  { file: 'openai.svg', name: 'OpenAI', h: 25, ratio: 3.719 },
  { file: 'dronedeploy.svg', name: 'DroneDeploy', h: 21, ratio: 6.121 },
];
---
<section class="theme-light logo-band" aria-labelledby="logos-title" id="industrial-clients">
  <div class="wrap py-12 md:py-16 flex flex-col xl:flex-row xl:items-center gap-8 xl:gap-14">
    <p id="logos-title" class="text-[14px] text-text-2 xl:max-w-[14ch] shrink-0 text-center xl:text-left">{label}</p>
    <ul class="flex-1 grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-10 lg:flex lg:items-center lg:justify-between lg:gap-x-8">
      {logos.map((l) => (
        <li class="flex items-center justify-center min-w-0 py-1">
          <img src={url(`logos/${l.file}`)} alt={l.name} width={Math.round(l.h * l.ratio)} height={l.h} style={`width:${Math.round(l.h * l.ratio)}px`} class="client-logo" loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
  <p class="wrap -mt-4 pb-8 text-[12px] text-text-3 text-center xl:text-left">Industrial work only. Logos are trademarks of their respective owners.</p>
</section>
