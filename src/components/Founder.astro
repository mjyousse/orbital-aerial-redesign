---
import Placeholder from './Placeholder.astro';
const creds = [
  'FAA Part 107 Commercial UAS Pilot',
  'FAA Private Pilot License',
  'Microsoft Azure & Azure AI Fundamentals',
  'Jamf Certified Associate',
  'DoD IAT Level I',
];
const record = [
  { k: 'Role', v: 'Founder & CTO, Orbital Aerial Solutions' },
  { k: 'In the air', v: 'FAA Part 107 remote pilot and FAA private pilot' },
  { k: 'On the ground', v: 'Certified in Microsoft Azure, Jamf and DoD IAT Level I' },
];
---
<section id="company" class="section theme-light scroll-mt-20" aria-labelledby="founder-title">
  <div class="wrap grid lg:grid-cols-[0.9fr_1.1fr] gap-14 lg:gap-24 items-start">
    <div data-reveal class="lg:sticky lg:top-28">
      <Placeholder label="Founder photo" class="aspect-square flex flex-col justify-end">
        <p>A professional headshot, or an in-field photo with the aircraft, goes here.</p>
      </Placeholder>
    </div>
    <div>
      <div data-reveal>
        <p class="eyebrow">Leadership</p>
        <h2 id="founder-title" class="mt-5 display-md">Precision you can defend.</h2>
        <p class="mt-8 lede text-text-2">Orbital Aerial Solutions is led by founder and CTO Mohammad Youssef, an FAA Part 107 commercial remote pilot who also holds an FAA private pilot license. He plans and flies missions with a manned-aviation mindset: airspace reviewed, risks assessed and every flight run to a checklist.</p>
        <p class="mt-5 lede text-text-2">He built Orbital around one rule: every dataset has to hold up when an engineer, an owner or an auditor checks it. Capture, processing and handoff are documented end to end, and the systems that store and deliver your data are run to the same standard.</p>
      </div>
      <dl class="mt-12 border-t line" data-reveal>
        {record.map((r) => (<div class="grid sm:grid-cols-[200px_1fr] gap-1 sm:gap-6 py-5 border-b line"><dt class="text-[14px] text-text-3">{r.k}</dt><dd class="font-display text-xl font-semibold tracking-tight">{r.v}</dd></div>))}
      </dl>
      <ul class="mt-10 flex flex-wrap gap-2" data-reveal>{creds.map((c) => <li class="px-4 py-2 rounded-full bg-paper-2 text-[14px] font-medium text-text-2">{c}</li>)}</ul>
    </div>
  </div>
</section>
