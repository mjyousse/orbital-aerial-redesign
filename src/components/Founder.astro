---
import Placeholder from './Placeholder.astro';
const creds = [
  'FAA Part 107 Commercial UAS Pilot',
  'FAA Private Pilot License',
  'Microsoft Azure & Azure AI Fundamentals',
  'Jamf Certified Associate',
  'DoD IAT Level I',
];
const record = [
  { k: 'Orbital', v: 'Founder & CTO, Orbital Aerial Solutions' },
  { k: 'Enterprise IT', v: 'Senior IT Specialist, The University of Texas at Austin' },
  { k: 'Financial infrastructure', v: 'Advanced Technical Operations, BlackRock' },
  { k: 'Technical service', v: 'Apple' },
];
---
<section id="company" class="section theme-light scroll-mt-20" aria-labelledby="founder-title">
  <div class="wrap grid lg:grid-cols-[0.9fr_1.1fr] gap-14 lg:gap-24 items-start">
    <div data-reveal class="lg:sticky lg:top-28">
      <Placeholder label="Founder photo" class="aspect-square flex flex-col justify-end">
        <p>A professional headshot, or an in-field photo with the aircraft, goes here.</p>
      </Placeholder>
    </div>
    <div>
      <div data-reveal>
        <p class="eyebrow">Leadership</p>
        <h2 id="founder-title" class="mt-5 display-md">Built to the standard of zero-downtime infrastructure.</h2>
        <p class="mt-8 lede text-text-2">Orbital Aerial Solutions was founded by Mohammad Youssef, a licensed pilot and technology leader whose career spans enterprise IT, financial infrastructure and aerial intelligence. Before Orbital, he supported live trading floors, pre-trade clearance systems and remote sales divisions across the Americas on BlackRock’s Advanced Technical Operations team, with 24/7 follow-the-sun handoffs to engineering teams in Europe and APAC.</p>
        <p class="mt-5 lede text-text-2">That environment demanded precision, multi-platform discipline and zero tolerance for downtime. Orbital runs every mission the same way.</p>
      </div>
      <dl class="mt-12 border-t line" data-reveal>
        {record.map((r) => (<div class="grid sm:grid-cols-[200px_1fr] gap-1 sm:gap-6 py-5 border-b line"><dt class="text-[14px] text-text-3">{r.k}</dt><dd class="font-display text-xl font-semibold tracking-tight">{r.v}</dd></div>))}
      </dl>
      <ul class="mt-10 flex flex-wrap gap-2" data-reveal>{creds.map((c) => <li class="px-4 py-2 rounded-full bg-paper-2 text-[14px] font-medium text-text-2">{c}</li>)}</ul>
    </div>
  </div>
</section>
