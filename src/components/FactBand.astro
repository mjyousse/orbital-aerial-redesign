---
const { items, note } = Astro.props as { items: { big: string; label: string }[]; note?: string };
---
<section class="theme-light invert-band border-y line" aria-label="Operating standards">
  <div class="wrap">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {items.map((it, i) => (
        <div class:list={['py-12 md:py-16 pr-4', i % 2 === 1 && 'pl-5 border-l line', i >= 1 && 'lg:pl-8 lg:border-l line', i >= 2 && 'max-lg:border-t']} data-reveal style={`--d:${i * 90}ms`}>
          <dt class="sr-only">{it.label}</dt>
          <dd class="font-display text-[clamp(2.6rem,5.4vw,4.6rem)] leading-none tracking-[-0.05em] font-semibold">{it.big}</dd>
          <dd class="mt-3 text-[15px] text-text-2 max-w-[22ch]">{it.label}</dd>
        </div>
      ))}
    </dl>
    {note && <p class="pb-8 -mt-2 text-[13px] text-text-3">{note}</p>}
  </div>
</section>
