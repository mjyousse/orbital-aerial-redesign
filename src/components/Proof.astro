---
import Placeholder from './Placeholder.astro';
const { division = 'industrial' } = Astro.props as { division?: 'industrial' | 'realestate' };
const stats = division === 'industrial'
  ? ['Acres mapped', 'Sites measured', 'Typical accuracy (cm)', 'Average turnaround (days)']
  : ['Listings shot', 'Average delivery (hours)', 'Repeat agents', 'Neighborhoods covered'];
---
<section class="section border-b hairline" aria-labelledby={`proof-${division}`}>
  <div class="wrap">
    <div class="max-w-3xl mb-10" data-reveal>
      <p class="tele">Proof</p>
      <h2 id={`proof-${division}`} class="mt-4 text-[clamp(1.8rem,3.4vw,2.6rem)] font-bold text-white">Results, in numbers and in clients’ words.</h2>
      <p class="mt-4 text-fg-2">These spots are ready for real figures, quotes and case studies. Nothing here is made up: fill them in once you have approved numbers.</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-reveal>
      {stats.map((s) => (
        <Placeholder label="Stat">
          <p class="font-display text-3xl font-bold text-white">Your stat here</p>
          <p class="mt-1 text-sm">{s}</p>
        </Placeholder>
      ))}
    </div>
    <div class="mt-4 grid lg:grid-cols-3 gap-4" data-reveal>
      <Placeholder label="Case study" class="lg:col-span-2">
        <p class="font-display text-xl text-white font-semibold">Case study coming soon</p>
        <p class="mt-2 text-sm">Suggested shape: the client’s problem → how we flew it → what we delivered → the result (time or money saved). Add a before/after image and a downloadable sample.</p>
      </Placeholder>
      <Placeholder label="Testimonial">
        <p class="font-display text-xl text-white font-semibold">“Client quote goes here.”</p>
        <p class="mt-2 text-sm">Name, role, company — with their permission.</p>
      </Placeholder>
    </div>
    <Placeholder label="Client logos" class="mt-4">
      <p class="text-sm">Add client or partner logos here once you have permission to show them.</p>
    </Placeholder>
  </div>
</section>
