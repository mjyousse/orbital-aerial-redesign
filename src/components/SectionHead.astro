---
const { eyebrow, title, lede, center = false, size = 'md', class: cls = '' } = Astro.props as { eyebrow?: string; title: string; lede?: string; center?: boolean; size?: 'md' | 'lg'; class?: string };
---
<div class:list={['max-w-3xl mb-14 md:mb-20', center && 'mx-auto text-center', cls]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class:list={[size === 'lg' ? 'display-lg' : 'display-md', eyebrow && 'mt-5']}>{title}</h2>
  {lede && <p class="mt-6 lede muted">{lede}</p>}
</div>
