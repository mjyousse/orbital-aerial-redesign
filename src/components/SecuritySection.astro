---
import { securityPillars as pillars } from '../lib/site';
const { id = 'security' } = Astro.props as { id?: string };
---
<section id={id} class="section theme-dark sec-band scroll-mt-16" aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 items-end mb-14 md:mb-16" data-reveal>
      <div>
        <p class="eyebrow">Data security</p>
        <h2 id={`${id}-title`} class="mt-5 display-lg text-white max-w-[15ch]">Controlled from capture to handoff.</h2>
      </div>
      <p class="lede text-fg-2 max-w-xl">Site data is often sensitive: plant layouts, infrastructure, inventory positions. Orbital treats it that way at every step, in the air and on the ground.</p>
    </div>
    <ol style="--rows:4" class="stack-grid grid sm:grid-cols-2 lg:grid-cols-5 items-stretch border-t border-white/10">
      {pillars.map((p, i) => (
        <li class="sec-pillar stack-card relative pt-6 pb-7 sm:pt-8 sm:pb-10 sm:odd:pr-6 lg:pr-7 lg:[&:not(:first-child)]:pl-7 lg:[&:not(:first-child)]:border-l border-white/10 max-sm:[&:not(:first-child)]:border-t" data-reveal style={`--d:${i * 70}ms`}>
          <div class="flex items-center justify-between">
            <span class="grid place-items-center w-11 h-11 rounded-full border border-white/15 text-signal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{p.icon.map((d) => <path d={d} />)}</svg>
            </span>
            <span class="text-[12px] font-medium tracking-[0.12em] uppercase text-fg-3">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <p class="mt-5 sm:mt-8 text-[13px] font-semibold text-signal">{p.label}</p>
          <h3 class="stack-card-title !mt-2 text-xl text-white leading-snug">{p.title}</h3>
          <p class="stack-card-body !mt-3 text-fg-2 text-[15px] leading-relaxed">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
