---
import { url } from '../lib/site';
import Arrow from './Arrow.astro';
// Claims here are limited to what Orbital already states elsewhere on the site.
const pillars = [
  { label: 'Fleet', title: 'Fleet matched to the contract', body: 'Capture runs on RTK-enabled aircraft, with NDAA-compliant aircraft available for contracts that require them.', icon: ['M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z', 'M9 12l2 2 4-4'] },
  { label: 'Ingestion', title: 'Air-gapped by design', body: 'Datasets move through air-gapped ingestion pipelines, engineered for zero data leakage from capture to handoff.', icon: ['M3 6h6v12H3z', 'M15 6h6v12h-6z', 'M11 9v1.5M11 13.5V15M13 9v1.5M13 13.5V15'] },
  { label: 'Handoff', title: 'Controlled, documented delivery', body: 'Files are delivered with controlled access. Every handoff documents the capture date, coordinate framework, control approach, processing method and agreed output formats.', icon: ['M7 3h7l4 4v14H7z', 'M14 3v4h4', 'M10 13l2 2 3-3.5'] },
  { label: 'Flight crew', title: 'Part 107 crew, manned-aviation experience', body: 'Our flight crew is FAA Part 107-certified, and our team includes licensed manned-aviation pilots who bring real airspace and aviation experience. Every flight runs inside a Safety Management System framework: preflight risk analysis, airspace review and standardized checklists. We handle the FAA clearances and airspace authorizations.', icon: ['M3 13.5l18-7-7 18-2.5-8.5z', 'M11.5 16l2.5-2.5'] },
  { label: 'Coverage', title: '$10M aviation liability', body: '$10M in specialized aviation liability coverage backs our flight operations. Project-specific insurance requirements are confirmed during scoping.', icon: ['M4 7h16v11H4z', 'M4 11h16', 'M8 15h3'] },
];
const { id = 'security' } = Astro.props as { id?: string };
---
<section id={id} class="section theme-dark sec-band scroll-mt-16" aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 items-end mb-14 md:mb-16" data-reveal>
      <div>
        <p class="eyebrow">Data security</p>
        <h2 id={`${id}-title`} class="mt-5 display-lg text-white max-w-[15ch]">Controlled from capture to handoff.</h2>
      </div>
      <p class="lede text-fg-2 max-w-xl">Site data is often sensitive: plant layouts, infrastructure, inventory positions. Orbital treats it that way at every step, in the air and on the ground.</p>
    </div>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-5 border-t border-white/10">
      {pillars.map((p, i) => (
        <li class="sec-pillar relative pt-6 pb-7 sm:pt-8 sm:pb-10 sm:odd:pr-6 lg:pr-7 lg:[&:not(:first-child)]:pl-7 lg:[&:not(:first-child)]:border-l border-white/10 max-sm:[&:not(:first-child)]:border-t" data-reveal style={`--d:${i * 70}ms`}>
          <div class="flex items-center justify-between">
            <span class="grid place-items-center w-11 h-11 rounded-full border border-white/15 text-signal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{p.icon.map((d) => <path d={d} />)}</svg>
            </span>
            <span class="text-[12px] font-medium tracking-[0.12em] uppercase text-fg-3">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <p class="mt-5 sm:mt-8 text-[13px] font-semibold text-signal">{p.label}</p>
          <h3 class="mt-2 text-xl text-white leading-snug">{p.title}</h3>
          <p class="mt-3 text-fg-2 text-[15px] leading-relaxed">{p.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-4 pt-8 border-t border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4" data-reveal>
      <p class="text-fg-2 text-[15px]">Procurement or IT review? A security brief or a completed vendor questionnaire is available on request.</p>
      <a href={url('contact/?division=industrial')} class="link-arrow text-white text-[15px] shrink-0">Request a security brief<Arrow /></a>
    </div>
  </div>
</section>
