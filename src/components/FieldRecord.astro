---
import Proof from './Proof.astro';
import CountUp from './CountUp.astro';
import { SHOW_STATS, SHOW_CASE_STUDY, STATS, CASE_STUDY } from '../data/fieldRecord';
const { eyebrow = 'Field record' } = Astro.props as { eyebrow?: string };
---
{SHOW_STATS && (
<section id="field-record" class="section theme-warm scroll-mt-16" aria-labelledby="field-title">
  <div class="wrap">
    <div class="grid lg:grid-cols-[1fr_1fr] gap-10 items-end mb-14" data-reveal>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="field-title" class="mt-5 display-md">Proven in the field.</h2>
      </div>
      <p class="lede text-text-2">Figures from our own flight operations. We map consistently, month after month, and we report only what we can stand behind.</p>
    </div>
    <dl class="grid sm:grid-cols-3 items-stretch border-t border-b line" data-reveal>
      {STATS.map((s, i) => (
        <div class:list={['py-10 md:py-14 sm:pr-6', i > 0 && 'max-sm:border-t sm:pl-8 sm:border-l line']}>
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-display text-[clamp(3rem,6.4vw,5.4rem)] leading-none tracking-[-0.05em] font-semibold"><CountUp value={s.value} prefix={s.prefix} suffix={s.suffix} /></dd>
          <dd class="mt-3 text-[16px] text-text-2 max-w-[22ch]">{s.label}</dd>
        </div>
      ))}
    </dl>
    {SHOW_CASE_STUDY && (
      <article class="mt-8 ph p-7 md:p-10" aria-label="Placeholder case study">
        <p class="ph-tag">{CASE_STUDY.tag} · not real data</p>
        <h3 class="mt-4 font-display text-3xl font-semibold tracking-tight">{CASE_STUDY.title}</h3>
        <dl class="mt-8 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {CASE_STUDY.steps.map((st, i) => (<div><dt class="text-[13px] text-text-3">{String(i + 1).padStart(2, '0')} · {st.k}</dt><dd class="mt-2 text-[15px] text-text-2">{st.v}</dd></div>))}
        </dl>
      </article>
    )}
  </div>
</section>
)}
{!SHOW_STATS && <Proof division="industrial" />}
