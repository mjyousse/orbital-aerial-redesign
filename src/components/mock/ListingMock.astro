---
import { Picture } from 'astro:assets';
import big from '../../assets/re/travis-5.jpg';
import phone from '../../assets/re/travis-2.jpg';
---
<figure class="relative pb-10">
  <div class="frame aspect-[4/3]">
    <Picture src={big} alt="Downtown Austin towers at night from the air, shot by Orbital" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 680px, 100vw" formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
    <span class="absolute left-3 top-3 chip chip-sample">Shot by Orbital</span>
  </div>
  <div class="absolute -bottom-2 right-4 sm:right-8 w-[38%] max-w-[210px] rounded-[28px] bg-ink-950 p-2 shadow-2xl ring-1 ring-white/10" data-reveal style="--d:200ms">
    <div class="rounded-[22px] overflow-hidden bg-paper text-text">
      <div class="relative aspect-[4/5]"><Picture src={phone} alt="" widths={[300, 450]} sizes="210px" formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} loading="lazy" class="absolute inset-0 w-full h-full object-cover" /></div>
      <div class="p-3">
        <p class="text-[11px] font-semibold">Listing preview</p>
        <p class="text-[10px] text-text-2">MLS · web · social exports</p>
        <div class="mt-2 flex gap-1"><span class="h-1 flex-1 rounded bg-text"></span><span class="h-1 flex-1 rounded bg-text/15"></span><span class="h-1 flex-1 rounded bg-text/15"></span></div>
      </div>
    </div>
  </div>
</figure>
