---
import { Picture } from 'astro:assets';
import img from '../../assets/stock/infrastructure-2560.jpg';
const pins = [ { n: 1, x: 31, y: 38 }, { n: 2, x: 88, y: 24 }, { n: 3, x: 13, y: 62 }, { n: 4, x: 72, y: 90 } ];
---
<figure class="relative">
  <div class="frame aspect-[4/3]">
    <Picture src={img} alt="Oblique aerial of an industrial storage facility with numbered sample inspection markers" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 680px, 100vw" formats={['avif', 'webp']} pictureAttributes={{ class: 'contents' }} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
    {pins.map((p, i) => (
      <span class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${p.x}%;top:${p.y}%`}>
        <span data-reveal style={`--d:${i * 120}ms`} class:list={['grid place-items-center w-8 h-8 rounded-full text-[13px] font-bold shadow-lg ring-4', i === 0 ? 'bg-signal text-black ring-signal/30' : 'bg-white text-black ring-white/30']}>{p.n}</span>
      </span>
    ))}
    <span class="absolute left-3 top-3 chip chip-sample">Sample view</span>
  </div>
  <div class="ui-card-dark relative mt-4 sm:mt-0 sm:absolute sm:-bottom-10 sm:left-[-1.5rem] sm:w-[290px] p-4 text-[13px]" data-reveal style="--d:200ms">
    <div class="flex items-center justify-between"><p class="font-semibold">Observation 01</p><span class="chip bg-signal text-black">For review</span></div>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-white/80">
      <dt class="text-white/60">Asset</dt><dd>Warehouse roof, north bay</dd>
      <dt class="text-white/60">Position</dt><dd>Coordinate-tagged</dd>
      <dt class="text-white/60">Imagery</dt><dd>Overview + detail set</dd>
      <dt class="text-white/60">Export</dt><dd>PDF · JPEG · GeoJSON</dd>
    </dl>
    <p class="mt-2 text-[11px] text-white/70">Sample layout, not a real inspection.</p>
  </div>
</figure>
