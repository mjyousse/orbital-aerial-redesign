---
import SectionHead from './SectionHead.astro';
const { eyebrow, title, steps, tone = 'warm' } = Astro.props as { eyebrow: string; title: string; steps: { step: string; title: string; body: string }[]; tone?: 'warm' | 'light' };
---
<section class:list={['section', tone === 'warm' ? 'theme-warm' : 'theme-light']} aria-label={title}>
  <div class="wrap">
    <SectionHead eyebrow={eyebrow} title={title} />
    <ol class="grid gap-px bg-line rounded-[20px] overflow-hidden" style={`grid-template-columns: repeat(auto-fit, minmax(${steps.length > 4 ? 200 : 240}px, 1fr));`}>
      {steps.map((s, i) => (
        <li class="bg-paper p-7 md:p-8 min-h-[240px] flex flex-col" data-reveal style={`--d:${i * 80}ms`}>
          <span class="font-display text-5xl font-semibold tracking-[-0.05em] text-signal-700">{s.step}</span>
          <h3 class="mt-auto pt-10 text-2xl">{s.title}</h3>
          <p class="mt-2 text-text-2 text-[15px]">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
