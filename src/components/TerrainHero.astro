---
import { url } from '../lib/site';
interface Props { eyebrow: string; title: string; accent?: string; lede: string; primary: { href: string; label: string }; secondary?: { href: string; label: string }; notes?: string[] }
const { eyebrow, title, accent, lede, primary, secondary, notes = [] } = Astro.props;
---
<section class="relative overflow-hidden border-b hairline min-h-[calc(100svh-6rem)] flex items-center" aria-labelledby="hero-title">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="terrain" style={`background-image: image-set(url('${url('sample/hero-terrain-960.webp')}') 1x, url('${url('sample/hero-terrain.webp')}') 2x);`}></div>
    <div class="scanline"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_40%,transparent_0%,rgb(7_11_18/0.55)_55%,rgb(7_11_18/0.95)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink-900 to-transparent"></div>
    <!-- HUD corners -->
    <svg class="absolute right-[8%] top-[22%] w-40 h-40 reticle hidden lg:block" viewBox="0 0 100 100" fill="none" stroke="var(--accent)" stroke-width="0.8">
      <circle cx="50" cy="50" r="30" stroke-dasharray="3 4"/><circle cx="50" cy="50" r="2" fill="var(--accent)"/>
      <path d="M50 8v12M50 80v12M8 50h12M80 50h12"/>
    </svg>
    <div class="absolute right-[8%] top-[calc(22%+10.5rem)] hidden lg:block tele-muted !text-[10px] leading-5 text-right">
      <div>Sample terrain · Austin TX</div>
      <div>30.32° N · 97.77° W</div>
      <div>Source · USGS 3DEP</div>
    </div>
  </div>
  <div class="wrap relative py-20">
    <p class="tele flex items-center gap-3"><span class="inline-block w-6 h-px bg-[var(--accent)]"></span>{eyebrow}</p>
    <h1 id="hero-title" class="mt-6 max-w-4xl text-[clamp(2.6rem,7vw,5.5rem)] font-bold text-white">
      {title}{accent && <><br /><span class="text-[var(--accent)]">{accent}</span></>}
    </h1>
    <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.6vw,1.25rem)] text-fg-2 leading-relaxed">{lede}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={primary.href} class="btn btn-primary text-base !px-6 !py-3.5">{primary.label}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {secondary && <a href={secondary.href} class="btn btn-ghost text-base !px-6 !py-3.5">{secondary.label}</a>}
    </div>
    {notes.length > 0 && (
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
        {notes.map((n) => <li class="tele-muted flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>{n}</li>)}
      </ul>
    )}
  </div>
</section>
