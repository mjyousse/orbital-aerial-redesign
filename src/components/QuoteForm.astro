---
import { SITE, serviceOptions } from '../lib/site';
const { division: initial = 'industrial', id = 'quote' } = Astro.props as { division?: 'industrial' | 'realestate'; id?: string };
---
<form id={id} class="panel p-5 sm:p-8 quote-form" data-initial={initial} action={`https://formsubmit.co/${SITE.email}`} method="POST" novalidate>
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_subject" value="Customer Inquiry" />
  <input type="hidden" name="_next" value="" />
  <input type="hidden" name="division" value="" />
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[10000px] w-px h-px overflow-hidden" />

  <div class="flex items-center justify-between gap-4 mb-6">
    <p class="tele" aria-live="polite"><span data-step-label>Step 01 / 03</span> · <span data-step-name>Service</span></p>
    <div class="flex gap-1.5 flex-1 max-w-40" aria-hidden="true">
      <span class="h-1 flex-1 rounded bg-[var(--accent)]" data-bar="0"></span>
      <span class="h-1 flex-1 rounded bg-ink-600" data-bar="1"></span>
      <span class="h-1 flex-1 rounded bg-ink-600" data-bar="2"></span>
    </div>
  </div>

  <!-- Step 1 -->
  <fieldset data-step="0" class="space-y-6">
    <legend class="font-display text-2xl text-white font-semibold mb-4">What do you need?</legend>
    <div class="grid sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Division">
      <label class="choice panel relative p-4 block">
        <input type="radio" name="division_choice" value="industrial" checked={initial === 'industrial'} />
        <span class="tele !text-cyan">Industrial</span>
        <span class="block mt-1 text-white font-semibold">Mapping, volumes, site data</span>
      </label>
      <label class="choice panel relative p-4 block">
        <input type="radio" name="division_choice" value="realestate" checked={initial === 'realestate'} />
        <span class="tele !text-amber">Real Estate</span>
        <span class="block mt-1 text-white font-semibold">Listing photos and video</span>
      </label>
    </div>
    <div class="field">
      <label for={`${id}-service`}>Service</label>
      <select id={`${id}-service`} name="service" required data-services={JSON.stringify(serviceOptions)}>
        <option value="">Select a service…</option>
      </select>
      <p class="hint" data-service-hint></p>
    </div>
  </fieldset>

  <!-- Step 2 -->
  <fieldset data-step="1" class="space-y-5" hidden>
    <legend class="font-display text-2xl text-white font-semibold mb-4">Where and when?</legend>
    <div class="field relative">
      <label for={`${id}-location`} data-loc-label>Site location</label>
      <input id={`${id}-location`} name="location" required autocomplete="street-address" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-suggest`} placeholder="Start typing the address" />
      <ul id={`${id}-suggest`} role="listbox" class="absolute z-20 left-0 right-0 mt-1 panel !bg-ink-800 overflow-hidden hidden"></ul>
      <p class="hint">Address search <a class="underline" href="https://www.geoapify.com/" target="_blank" rel="noreferrer">powered by Geoapify</a>.</p>
    </div>
    <div class="field">
      <label for={`${id}-timeline`} data-time-label>Target timeline</label>
      <input id={`${id}-timeline`} name="timeline" placeholder="Month or target date" />
      <p class="hint" data-time-hint>An estimated window is fine.</p>
    </div>
    <div class="field">
      <label for={`${id}-message`}>Project details <span class="text-fg-3 font-normal">(optional)</span></label>
      <textarea id={`${id}-message`} name="message" rows="4" data-msg placeholder="Site size, access constraints, control information and the deliverables your team needs."></textarea>
    </div>
  </fieldset>

  <!-- Step 3 -->
  <fieldset data-step="2" class="space-y-5" hidden>
    <legend class="font-display text-2xl text-white font-semibold mb-4">How do we reach you?</legend>
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="field"><label for={`${id}-name`}>Full name</label><input id={`${id}-name`} name="name" required autocomplete="name" placeholder="Jane Smith" /></div>
      <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" required autocomplete="email" placeholder="jane@company.com" /></div>
      <div class="field"><label for={`${id}-phone`}>Phone <span class="text-fg-3 font-normal">(optional)</span></label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" placeholder="(512) 555-0199" /></div>
      <div class="field"><label for={`${id}-company`} data-co-label>Company <span class="text-fg-3 font-normal">(optional)</span></label><input id={`${id}-company`} name="company" autocomplete="organization" /></div>
    </div>
    <p class="text-sm text-fg-3">We reply within one business day with pricing and availability.</p>
  </fieldset>

  <p class="mt-5 text-sm text-[#ff9b9b]" role="alert" data-error></p>

  <div class="mt-6 flex gap-3">
    <button type="button" class="btn btn-ghost" data-back hidden>Back</button>
    <button type="button" class="btn btn-primary flex-1" data-next>Continue</button>
    <button type="submit" class="btn btn-primary flex-1" data-submit hidden>Send request</button>
  </div>

  <div data-done hidden class="text-center py-10">
    <p class="tele">Request received</p>
    <p class="mt-3 font-display text-3xl text-white font-bold">Thanks — we’ll be in touch.</p>
    <p class="mt-3 text-fg-2">Expect a reply within one business day at the email you gave us.</p>
  </div>
</form>

<script>
  import { initQuoteForm } from '../scripts/quote';
  document.querySelectorAll<HTMLFormElement>('form.quote-form').forEach(initQuoteForm);
</script>
