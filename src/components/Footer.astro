---
import { SITE, url } from '../lib/site';
---
<footer class="theme-dark pb-24 md:pb-0">
  <div class="wrap pt-24 pb-16">
    <div class="grid gap-14 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <img src={url('brand/logo-dark.svg')} alt="Orbital Aerial Solutions" width="96" height="67" class="h-14 w-auto" loading="lazy" />
        <p class="mt-6 font-display text-2xl font-semibold tracking-tight max-w-sm leading-snug">Aerial intelligence for operations where precision matters.</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-white mb-4">Services</h2>
        <ul class="space-y-2.5 text-fg-2 text-[15px]">
          <li><a class="hover:text-white text-white/90 font-medium" href={url('industrial/')}>Industrial</a></li>
          <li><a class="hover:text-white" href={url('industrial/#services')}>Sample deliverables</a></li>
          <li><a class="hover:text-white" href={url('industrial/#credentials')}>Credentials</a></li>
          <li class="pt-3"><a class="hover:text-white text-white/90 font-medium" href={url('real-estate/')}>Real Estate Media</a></li>
          <li><a class="hover:text-white" href={url('real-estate/#packages')}>Packages</a></li>
          <li><a class="hover:text-white" href={url('real-estate/#work')}>Recent work</a></li>
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-white mb-4">Company</h2>
        <ul class="space-y-2.5 text-fg-2 text-[15px]">
          <li><a class="hover:text-white" href={url('#operations')}>Operations</a></li>
          <li><a class="hover:text-white" href={url('#security')}>Data security</a></li>
          <li><a class="hover:text-white" href={url('#coverage')}>Coverage</a></li>
        </ul>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-white mb-4">Contact</h2>
        <ul class="space-y-2.5 text-fg-2 text-[15px]">
          <li><a class="hover:text-white" href={url('contact/')}>Request a quote</a></li>
          <li><a class="hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>Austin, Texas</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap py-6 flex flex-col sm:flex-row gap-3 justify-between text-sm text-fg-3">
      <p>© 2026 Orbital Aerial Solutions. All rights reserved.</p>
    </div>
  </div>
</footer>
