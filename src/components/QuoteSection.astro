---
import QuoteForm from './QuoteForm.astro';
import { SITE } from '../lib/site';
const { division = 'industrial', title = 'Tell us about your site.', lede = 'Three quick steps. We reply within one business day with pricing and availability.' } = Astro.props as { division?: 'industrial' | 'realestate'; title?: string; lede?: string };
---
<section id="quote" class="section relative overflow-hidden" aria-labelledby="quote-title">
  <div class="absolute inset-0 grid-bg opacity-60 [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]" aria-hidden="true"></div>
  <div class="wrap relative grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-start">
    <div data-reveal>
      <p class="tele">Request a quote</p>
      <h2 id="quote-title" class="mt-4 text-[clamp(2rem,4.2vw,3.25rem)] font-bold text-white">{title}</h2>
      <p class="mt-5 text-lg text-fg-2">{lede}</p>
      <dl class="mt-10 space-y-5">
        <div><dt class="tele-muted">Email</dt><dd class="mt-1"><a class="text-white text-lg hover:text-[var(--accent)]" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div><dt class="tele-muted">Based in</dt><dd class="mt-1 text-white text-lg">Austin, Texas</dd></div>
        <div><dt class="tele-muted">Coverage</dt><dd class="mt-1 text-fg-2">Real estate: 15 miles from Austin, travel quoted beyond. Industrial: projects scoped nationwide.</dd></div>
      </dl>
    </div>
    <QuoteForm division={division} />
  </div>
</section>
