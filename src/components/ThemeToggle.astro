<button type="button" class="theme-toggle" data-mode="auto" aria-label="Color theme: Auto. Switch to Light." title="Theme: Auto (follows your device)">
  <svg class="ti-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
  <svg class="ti-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ti-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
</button>
<script>
  const order = ['auto', 'light', 'dark'] as const;
  type Mode = (typeof order)[number];
  const label: Record<Mode, string> = { auto: 'Auto', light: 'Light', dark: 'Dark' };
  const api = (window as any).__oasTheme as { mode: Mode; set: (m: Mode) => void };
  const next = (m: Mode) => order[(order.indexOf(m) + 1) % order.length];
  const sync = () => {
    const m = api.mode;
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
      b.dataset.mode = m;
      b.setAttribute('aria-label', `Color theme: ${label[m]}. Switch to ${label[next(m)]}.`);
      b.title = m === 'auto' ? 'Theme: Auto (follows your device)' : `Theme: ${label[m]}`;
    });
  };
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => b.addEventListener('click', () => { api.set(next(api.mode)); sync(); }));
  document.addEventListener('themechange', sync);
  sync();
</script>
